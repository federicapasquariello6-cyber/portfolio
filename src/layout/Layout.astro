---
import "../styles/global.css";

const { title = "FP" } = Astro.props;
---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>

<body>

<div class="cursor" id="cursor"></div>

<header class="nav">

  <a href="/" class="logo gradient-text">
    FP
  </a>

  <button
    class="menu-toggle"
    id="menuToggle"
    aria-label="Apri menu"
    aria-expanded="false"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav id="mainNav">

    <a
      href="/"
      class={`gradient-text ${Astro.url.pathname === "/" ? "active" : ""}`}
    >
      Home
    </a>

    <a
      href="/about"
      class={Astro.url.pathname === "/about" ? "active" : ""}
    >
      About
    </a>

    <a
      href="/progetti"
      class={Astro.url.pathname === "/progetti" ? "active" : ""}
    >
      Progetti
    </a>

    <a
      href="/cv"
      class={Astro.url.pathname === "/cv" ? "active" : ""}
    >
      CV
    </a>

    <a
      href="/contatti"
      class={Astro.url.pathname === "/contatti" ? "active" : ""}
    >
      Contatti
    </a>

  </nav>

</header>

<script>
const nav = document.querySelector(".nav");

window.addEventListener("scroll", () => {
  nav?.classList.toggle("scrolled", window.scrollY > 10);
});
</script>

<script>
const toggle = document.getElementById("menuToggle");
const menu = document.getElementById("mainNav");

if (toggle && menu) {

  toggle.addEventListener("click", () => {

    const isOpen = menu.classList.toggle("open");

    toggle.setAttribute("aria-expanded", isOpen);

    if (isOpen) {

      toggle.innerHTML = "✕";

    } else {

      toggle.innerHTML = `
        <span></span>
        <span></span>
        <span></span>
      `;

    }

  });

  menu.querySelectorAll("a").forEach(link => {

    link.addEventListener("click", () => {

      menu.classList.remove("open");

      toggle.setAttribute("aria-expanded", "false");

      toggle.innerHTML = `
        <span></span>
        <span></span>
        <span></span>
      `;

    });

  });

}
</script>

<script>
const cursor = document.getElementById("cursor");

if (cursor) {

  let mouseX = 0;
  let mouseY = 0;

  let currentX = 0;
  let currentY = 0;

  let hasMoved = false;

  window.addEventListener("mousemove", (e) => {

    mouseX = e.clientX;
    mouseY = e.clientY;

    if (!hasMoved) {

      currentX = mouseX;
      currentY = mouseY;
      hasMoved = true;

    }

    cursor.classList.add("is-visible");

  });

  document.querySelectorAll("a, button, .btn, .card, .item, .project-card, input, textarea")
    .forEach(el => {

      el.addEventListener("mouseenter", () => cursor.classList.add("is-hovering"));
      el.addEventListener("mouseleave", () => cursor.classList.remove("is-hovering"));

    });

  document.addEventListener("mouseleave", () => cursor.classList.remove("is-visible"));
  document.addEventListener("mouseenter", () => cursor.classList.add("is-visible"));

  function animateCursor() {

    currentX += (mouseX - currentX) * 0.18;
    currentY += (mouseY - currentY) * 0.18;

    cursor.style.left = `${currentX}px`;
    cursor.style.top = `${currentY}px`;

    requestAnimationFrame(animateCursor);

  }

  animateCursor();

}
</script>

<main class="container">
  <slot />
</main>

<script>
const revealEls = document.querySelectorAll(".reveal-on-scroll");

const observer = new IntersectionObserver((entries) => {

  entries.forEach(entry => {

    if (entry.isIntersecting) {

      entry.target.classList.add("is-visible");
      observer.unobserve(entry.target);

    }

  });

}, { threshold: 0.15 });

revealEls.forEach(el => observer.observe(el));
</script>

<footer class="footer">
  <p>© {new Date().getFullYear()} FP</p>
</footer>

</body>
</html>
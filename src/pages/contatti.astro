---
import Layout from "../layout/Layout.astro";

const sent = Astro.url.searchParams.get("success") === "true";
---

<Layout title="Contatti">

<section class="page-wrapper">

  <a class="back-arrow" href="/">←</a>

  <div class="page-box">
    <h1>Contatti</h1>
    <p>Scrivimi per collaborazioni o informazioni.</p>
  </div>

  <div class="contact">

    <div class="info">

      <div class="box">
        <h3>Email</h3>
        <a class="mail-link" href="mailto:federica.pasquariello.6@gmail.com">
          federica.pasquariello.6@gmail.com
        </a>
      </div>

    </div>

    <form class="form" method="POST" action="/api/contatto">

      <input type="text" name="name" placeholder="Nome" required />
      <input type="email" name="email" placeholder="Email" required />
      <textarea name="message" placeholder="Messaggio" required></textarea>

      <button class="btn" type="submit">
        Invia messaggio
      </button>

      {sent && <p class="form-status">Messaggio inviato correttamente.</p>}

    </form>

  </div>

</section>

</Layout>

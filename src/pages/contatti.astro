---
import Layout from "../layout/Layout.astro";
---

<Layout title="Contatti">

<a class="back-arrow" href="/">←</a>


<section class="page-wrapper">

  <div class="page-box">
    <h1>Contatti</h1>
    <p>Scrivimi per collaborazioni o informazioni.</p>
  </div>

  <div class="contact">

    <div class="info">

      <div class="box">
        <h3>Email</h3>
        <p>federica.pasquariello.6@gmail.com</p>
      </div>

      <div class="box">
        <h3>Disponibilità</h3>
        <p>Progetti junior e accademici</p>
      </div>

    </div>

    <form class="form">

      <input type="text" placeholder="Nome" />
      <input type="email" placeholder="Email" />
      <textarea placeholder="Messaggio"></textarea>

      <a class="btn" href="mailto:federica.pasquariello.6@gmail.com.com">
        Invia messaggio
      </a>

    </form>

  </div>

</section>

</Layout>
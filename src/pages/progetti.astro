---
import Layout from "../layout/Layout.astro";
import { projects } from "../data/projects.js";
---

<Layout title="Progetti">

<section class="page-wrapper">

  <a class="back-arrow" href="/">←</a>

  <div class="page-box">
    <h1>Progetti</h1>
    <p>Raccolta di lavori accademici e progetti personali.</p>
  </div>

  <div class="grid">

    {projects.map((project) => (
      <a class="card project-card reveal-on-scroll" href={`/progetti/${project.slug}`}>
        <div class={`preview ${project.previewClass}`}></div>

        <h3>{project.title}</h3>
        <p>{project.description}</p>

        <div class="tags">
          {project.tags.map((tag) => <span>{tag}</span>)}
        </div>
      </a>
    ))}

  </div>

</section>

</Layout>

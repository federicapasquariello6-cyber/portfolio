---
import Layout from "../layout/Layout.astro";
---

<Layout title="Progetti">

<a class="back-arrow" href="/">←</a>

<section class="page-wrapper">

  <div class="page-box">
    <h1>Progetti</h1>
    <p>Raccolta di lavori accademici e progetti personali.</p>
  </div>

  <div class="grid">

    <!-- PROGETTO 1 -->
    <div class="card">
      <div class="preview project-1"></div>

      <h3>Portfolio personale</h3>
      <p>Sito web realizzato con Astro per presentazione CV e progetti.</p>

      <div class="tags">
        <span>Astro</span>
        <span>CSS</span>
      </div>
    </div>

    <!-- PROGETTO 2 -->
    <div class="card">
      <div class="preview project-2"></div>

      <h3>Progetti universitari</h3>
      <p>Analisi e lavori accademici in ingegneria energetica.</p>

      <div class="tags">
        <span>Engineering</span>
        <span>Study</span>
      </div>
    </div>

    <!-- PROGETTO 3 -->
    <div class="card">
      <div class="preview project-3"></div>

      <h3>UI Concepts</h3>
      <p>Prototipi interfacce web moderne e responsive.</p>

      <div class="tags">
        <span>UI</span>
        <span>Frontend</span>
      </div>
    </div>

  </div>

</section>

</Layout>